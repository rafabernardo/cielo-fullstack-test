# Copy to .env and adjust.

# Base of the backend API, sent to the browser and validated in src/config/env.ts. Keep it relative (/api): the
# backend has no CORS, so the browser reaches it through the proxy below (Vite dev) or nginx (Docker).
VITE_API_URL=/api

# Backend that /api is proxied to by the Vite dev server. No VITE_ prefix: never sent to the browser.
API_PROXY_TARGET=http://localhost:8080
